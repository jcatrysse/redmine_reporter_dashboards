<%# Two intros — see the text part. %>
<% if @external %>
  <p><%= l(:text_reporter_adhoc_mail_intro_external, name: @template_name, user: @requester.name, site: Setting.app_title) %></p>
<% else %>
  <p><%= l(:text_reporter_adhoc_mail_intro, name: @template_name, user: @requester.name) %></p>
<% end %>

<%# FR-47 — see the text part for why this line is not decoration. %>
<p><%= l(:text_reporter_adhoc_mail_rendered_as, user: @requester.name) %></p>

<% if @project %>
  <p><%= l(:field_project) %>: <%= @project.name %></p>
<% end %>

<p style="color:#888;"><%= l(:label_reporter_report_diagnostic_correlation_id) %>: <%= @correlation_id %></p>
