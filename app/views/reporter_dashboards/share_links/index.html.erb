<%#
  T-28 increment 3 — what §7b.1 asks for in one page: *"you can see what you have shared,
  to whom it is reaching, and take it back."*

  Redmine's own chrome only: `.contextual`, `h2`, `table.list`, `p.nodata`, `.warning`,
  `.info`. CLAUDE.md §4 forbids plugin-local design tokens in chrome and there are none.

  --- WHY EVERY LINK IS LISTED AND NOT ONLY THE LIVE ONES ---

  `ShareLink.for_template` is deliberately unfiltered, and its comment says why: a revoked
  link is the thing somebody most wants to CONFIRM is revoked, and an expired one is what
  explains why a recipient is complaining. A list that showed only working links would be
  silent in both of the situations that bring somebody to this page.
%>
<div class="contextual">
  <%= link_to reporter_dashboard_icon('add', l(:label_reporter_share_link_new)),
              new_project_reporter_template_share_link_path(@project, @template),
              class: 'icon icon-add' %>
</div>

<h2><%= l(:label_reporter_share_link_plural) %></h2>

<p><%= link_to @template.name, project_reporter_template_path(@project, @template) %></p>

<%#
  THE TOKEN, SHOWN ONCE AND NEVER AGAIN. Only its digest is stored, so this is the single
  moment the URL exists anywhere — there is no page, no console and no database query that
  can recover it afterwards. Said plainly, because a person who assumes they can come back
  for it will close the tab.

  It arrives in its OWN flash key rather than in `:notice`, so that the shared notice
  partial cannot print a credential by accident.
%>
<% if flash[:reporter_share_url].present? %>
  <div class="info">
    <p><strong><%= l(:text_reporter_share_url_once) %></strong></p>
    <p><input type="text" readonly="readonly" size="80" value="<%= flash[:reporter_share_url] %>" /></p>
  </div>
<% end %>

<% if @links.any? %>
  <table class="list">
    <thead>
      <tr>
        <th><%= l(:label_reporter_share_link_state) %></th>
        <th><%= l(:field_reporter_share_link_purpose) %></th>
        <th><%= l(:field_reporter_share_link_public) %></th>
        <th><%= l(:field_reporter_share_link_created_by) %></th>
        <th><%= l(:field_reporter_share_link_expires_at) %></th>
        <th><%= l(:field_reporter_share_link_uses) %></th>
        <th><%= l(:field_reporter_share_link_last_used_at) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @links.each do |link| %>
        <tr class="<%= cycle('odd', 'even') %>">
          <%# THE STATE IN WORDS, not a coloured dot: "revoked", "expired" and "used up" are
              three different things to somebody deciding what to do next, and a reader using
              a screen reader or a monochrome print gets nothing from colour alone. %>
          <td><%= l(:"label_reporter_share_link_state_#{link.refusal || :live}") %></td>
          <td><%= link.purpose %></td>
          <td><%= link.public_link? ? l(:general_text_Yes) : l(:general_text_No) %></td>
          <td><%= link.created_by ? link_to_user(link.created_by) : '' %></td>
          <td><%= format_time(link.expires_at) %></td>
          <%# `max_uses` NIL MEANS NO LIMIT, and printing "3 / " would read as a missing
              value rather than as "unlimited". %>
          <td>
            <% if link.max_uses %>
              <%= "#{link.use_count} / #{link.max_uses}" %>
            <% else %>
              <%= link.use_count %>
            <% end %>
          </td>
          <td><%= link.last_used_at ? format_time(link.last_used_at) : l(:label_reporter_share_link_never_used) %></td>
          <td>
            <%# DRAWN ONLY FOR SOMEBODY WHO MAY ACTUALLY USE IT. Revocation is ownership
                rather than a permission (FR-53), so a colleague holding every permission in
                Redmine sees no button here — and would get 403 if they forged the request.
                A button that answers 403 is the "capability nobody can reach" defect
                pointed the other way. %>
            <% if link.revocable_by?(User.current) && !link.revoked? %>
              <%= link_to l(:button_reporter_share_link_revoke),
                          revoke_project_reporter_template_share_link_path(@project, @template, link),
                          method: :post,
                          data: { confirm: l(:text_reporter_share_link_revoke_confirm) },
                          class: 'icon icon-del' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%# "REVOKE ALL" IS THE BUTTON SOMEBODY REACHES FOR WHEN THEY ALREADY KNOW SOMETHING HAS
      GONE WRONG, which is why it is offered plainly rather than hidden — and why it is
      DELETE with a confirmation. It revokes what THIS actor may revoke, which is not
      necessarily every link in the table. %>
  <% if @links.any? { |link| link.revocable_by?(User.current) && !link.revoked? } %>
    <p>
      <%= link_to l(:button_reporter_share_links_revoke_all),
                  revoke_all_project_reporter_template_share_links_path(@project, @template),
                  method: :delete,
                  data: { confirm: l(:text_reporter_share_links_revoke_all_confirm) },
                  class: 'icon icon-del' %>
    </p>
  <% end %>
<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>

<% html_title l(:label_reporter_share_link_plural) %>
