<h2><%= reporter_schedule_name(@schedule) %></h2>

<%= labelled_form_for :schedule, @schedule,
                      url: project_reporter_schedule_path(@project, @schedule),
                      html: { method: :patch, id: 'reporter-schedule-form' } do |f| %>
  <%= render partial: 'form', locals: { f: f } %>
  <p>
    <%= submit_tag l(:button_save) %>
    <%= link_to l(:button_cancel), project_reporter_schedule_path(@project, @schedule) %>
  </p>
<% end %>
