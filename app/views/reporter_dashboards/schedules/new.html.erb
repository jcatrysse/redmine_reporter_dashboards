<h2><%= l(:label_reporter_schedule_new) %></h2>

<%= labelled_form_for :schedule, @schedule,
                      url: project_reporter_schedules_path(@project),
                      html: { method: :post, id: 'reporter-schedule-form' } do |f| %>
  <%= render partial: 'form', locals: { f: f } %>
  <p>
    <%= submit_tag l(:button_create) %>
    <%= link_to l(:button_cancel), project_reporter_schedules_path(@project) %>
  </p>
<% end %>
