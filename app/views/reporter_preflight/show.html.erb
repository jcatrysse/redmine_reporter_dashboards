<%#
  T-14 — the render preflight, for an administrator.

  Redmine's own chrome only: `.box`, `table.list`, `p.buttons`, the core icon classes.
  CLAUDE.md §4 forbids plugin-local design tokens here, and this page has none: it is
  meant to look like the rest of the admin area, not like a plugin's idea of one.

  THE EMPTY STATE IS THE DEFAULT STATE. Landing here runs nothing — see the controller
  on why `run` is a POST — so the first thing an administrator reads is what the button
  is about to do and how long it takes.
%>
<h2><%= l(:label_reporter_preflight) %></h2>

<div class="box">
  <p><%= l(:text_reporter_preflight_intro) %></p>
  <p><em><%= l(:text_reporter_preflight_takes_a_moment) %></em></p>
</div>

<%= form_tag(run_reporter_preflight_path, method: :post) do %>
  <p class="buttons">
    <%= submit_tag l(:button_reporter_preflight_run), name: nil %>
  </p>
<% end %>

<% if @reports %>
  <% if @reports.empty? %>
    <%#
      Not a blank page. "No engine is registered" is a real answer and the most
      alarming one — it means nothing can render at all — so it says so rather than
      leaving an administrator to conclude the page is broken.
    %>
    <p class="nodata"><%= l(:text_reporter_preflight_no_engine) %></p>
  <% end %>

  <% @reports.each do |report| %>
    <h3>
      <%= report.engine_id %>
      <span class="icon <%= report.ok? ? 'icon-ok' : 'icon-error' %>"></span>
    </h3>

    <p>
      <%= reporter_preflight_summary(report) %>
      <span class="nodata">
        <%= l(:label_reporter_preflight_engine_version) %>:
        <%= report.engine_version %>,
        <%= l(:label_reporter_preflight_duration) %>:
        <%= reporter_preflight_duration(report.duration_ms) %>
      </span>
    </p>

    <table class="list">
      <thead>
        <tr>
          <th><%= l(:label_reporter_preflight_state) %></th>
          <th><%= l(:label_reporter_preflight_check) %></th>
          <th><%= l(:label_reporter_preflight_detail) %></th>
          <th><%= l(:label_reporter_preflight_duration) %></th>
        </tr>
      </thead>
      <tbody>
        <% report.checks.each do |check| %>
          <tr>
            <td>
              <span class="<%= reporter_preflight_state_class(check.state) %>"></span>
              <%= reporter_preflight_state_label(check.state) %>
            </td>
            <td><%= reporter_preflight_check_label(check) %></td>
            <%#
              `detail` carries an engine's message, an exception's text and a URL — all
              of it from outside this plugin. ERB escapes it here, and nothing on this
              page is marked as trusted markup (INV-9, and the gate that counts the
              exceptions to it).
            %>
            <td><%= check.detail %></td>
            <td><%= reporter_preflight_duration(check.duration_ms) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <%#
    THE ARTEFACT, WHERE THE PERSON WITHOUT A SHELL CAN REACH IT.

    The Accept list wants structured JSON "so it is asserted on rather than
    log-scraped", and `RRD_FORMAT=json` gives the rake user exactly that. This page
    exists for the administrator who has no shell — so without this block, the one
    user it was built for is the one user who cannot paste the report into an issue.
  %>
  <% if @reports.any? %>
    <fieldset class="collapsible collapsed">
      <legend onclick="toggleFieldset(this);"><%= l(:label_reporter_preflight_json) %></legend>
      <div style="display: none;">
        <p><%= l(:text_reporter_preflight_json) %></p>
        <pre><%= JSON.pretty_generate(@reports.map(&:to_h)) %></pre>
      </div>
    </fieldset>
  <% end %>
<% end %>
